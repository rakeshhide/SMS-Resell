# Database Configuration (PostgreSQL / Neon)
NEON_DB=postgresql://username:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# Authentication & Security
JWT_SECRET=your_high_entropy_jwt_secret_64_characters
JWT_EXPIRES_IN=7d

# SMS Provider Credentials (Stored exclusively on server)
FAST2SMS_ENDPIONT=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_API_KEY=your_fast2sms_api_key

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
